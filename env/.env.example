# FILE: env/.env.example
# Settings loaded by config/env.config.ts (TEST_ENV picks the file; default qa). See PROJECT_GUIDE.txt.
# Copy to env/.env.<name> and run with TEST_ENV=<name>
BASE_URL=https://www.saucedemo.com
DEFAULT_PASSWORD=secret_sauce
TAX_RATE=0.08
DEFAULT_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# Browser to run the tests on:
#   chrome   = Google Chrome installed on this PC (default)
#   msedge   = Microsoft Edge installed on this PC
#   chromium | firefox | webkit = Playwright's own browsers (npx playwright install <name>)
#   all      = every project (used by npm run test:all-browsers)
# A value set in the terminal/CI (e.g. via the npm scripts) overrides this one.
BROWSER=chrome
